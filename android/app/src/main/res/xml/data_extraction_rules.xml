<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The two cases are deliberately different.

     cloud-backup  : excluded. A Google-hosted backup that can be restored onto
                     any device is the wrong place for an entitlement flag, and
                     learning history shouldn't leave the device silently.
     device-transfer: included. Phone-to-phone transfer needs physical
                     possession of both devices, and losing your progress on a
                     phone upgrade is a genuine complaint about the apps we're
                     competing with. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
